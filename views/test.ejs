  <script>
    $(() => {
      Getdocument('life');
    });

    function Getdocument(point) {
      $.ajax({
        url: `${window.location.origin}/getArticle/${point}`,
        async: false,
        method: "GET",
        success: (article, textStatus, jqXHR) => {
          let result = JSON.parse(article);
          $("#modal").empty().append($(result["article"])).scrollTop(0);
        },
        error: (jqXHR, textStatus, errorThrown) => {
          console.log(jqXHR + "\r\n" + textStatus + "\r\n" + errorThrown);
        }
      });
    }
  </script>
  <style>
    #nav_container {
