    .sticky_nav {
      display: flex;
      position: relative;
      z-index: 1;
      height: fit-content;
      width: 22%;
      right: 0;
      top: 5%;
      float: left;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .sticky_nav>a {
      background-color: #28a745;
      text-align: center;
      cursor: pointer;
      border-style: inset;
      border-radius: 50%;
      border-width: 1px;
      border-color: #28a745;
      color: black;
      transition-property: text-decoration, color;
      transition-timing-function: linear;
    }

    .sticky_nav>a:hover {
      text-decoration: underline;
      color: white;
    }

    .sticky_nav>* {
      width: 100%;
      float: left;
    }

    .sticky_nav>* ::after {
      content: "";
      clear: both;
    }

    #modal_container {
      position: relative;
      width: 30vw;
      height: 90vh;
      float: left;
      z-index: 1;
    }

    .modal {
      display: flex;
      position: relative;
      /* Stay in place */
      z-index: 1;
      /* Sit on top */
      width: 75%;
      /* Full width */
      height: 100%;
      /* Full height */
      overflow-y: scroll;
      overflow-x: visible;
      /* Enable scroll if needed */
      background-color: rgb(255, 255, 255);
      /* Fallback color */
      background-color: rgba(255, 255, 255, 1);
      /* Black w/ opacity */
      border-radius: 25px;
      border-color: black;
      border-width: 1px;
      border-style: outset;
      box-shadow: 2px 2px 10px rgba(71, 71, 71, 0.4);
      padding-top: 3%;
      padding-bottom: 3%;
      padding-left: 3%;
      padding-right: 3%;
      margin-top: 1%;
      margin-left: 1%;
      white-space: pre-wrap;
      flex-direction: column;
      user-select: none;
      float: left;
      scroll-behavior: smooth;
    }

    .modal::after,
    .sticky_nav::after {
      content: "";
      clear: both;
    }

    td {
      border-color: black;
      border-style: solid;
      border-width: 2px;
    }

    td :nth-child(1) {
      text-align: left;
    }

    td :nth-child(2) {
      text-align: right;
    }

    table::after {
      content: "\a\a";
    }

